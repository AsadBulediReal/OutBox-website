# Outbox Downloader — Development Environment Configuration
# Loaded automatically by Vite during `npm run dev`

# Google AdSense Publisher / Client ID (Leave blank or set to your test client ID)
# Format: ca-pub-XXXXXXXXXXXXXXXX
VITE_ADSENSE_CLIENT_ID=

# Enable mock sponsor ads preview in development to test layout & responsive rendering (true / false)
VITE_ENABLE_MOCK_ADS=true

# Application Metadata
VITE_APP_TITLE="Outbox Downloader (Dev)"
VITE_APP_VERSION="1.0.5"
VITE_SITE_URL="http://localhost:5173"

# Direct Download URLs for Installers (Optional overrides for local testing)
VITE_DOWNLOAD_WIN_URL=""
VITE_DOWNLOAD_MAC_URL=""
