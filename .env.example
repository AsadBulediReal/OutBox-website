# Outbox Downloader — Environment Variables Template
# Copy this file to `.env.local` or `.env.development` to configure local settings.

# Google AdSense Publisher / Client ID
# Format: ca-pub-XXXXXXXXXXXXXXXX
VITE_ADSENSE_CLIENT_ID="ca-pub-1722794534248442"

# Enable preview mock partner ads (true / false)
VITE_ENABLE_MOCK_ADS=false

# Application Metadata
VITE_APP_TITLE="Outbox Downloader"
VITE_APP_VERSION=
VITE_SITE_URL="https://outboxdownloader.com"

# Direct Download URLs for Installers (Optional overrides)
VITE_DOWNLOAD_WIN_URL=""
VITE_DOWNLOAD_MAC_URL=""
