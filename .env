# Outbox Downloader — Base Environment Variables
# Applied across all environments unless overridden by mode-specific .env files

VITE_APP_TITLE="Outbox Downloader"
VITE_APP_VERSION="2.4.0"
VITE_SITE_URL="https://outboxdownloader.com"
VITE_ENABLE_MOCK_ADS=false
# Google AdSense Publisher ID (e.g. ca-pub-1234567890123456)
# In Netlify / production: set VITE_ADSENSE_CLIENT_ID in your hosting environment variables
# During build, Vite automatically embeds the official Google AdSense script into index.html
VITE_ADSENSE_CLIENT_ID=
VITE_DOWNLOAD_WIN_URL=""
VITE_DOWNLOAD_MAC_URL=""
